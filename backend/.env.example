# Copy this file to .env and fill in your own values before running the app.

# MySQL connection - update the username/password/host to match your local MySQL setup.
# Format: mysql+pymysql://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL=mysql+pymysql://SakshiAwatade:Sakshi@123@localhost:3306/welfarebridge09

# Secret used to sign JWT tokens. Change this to a long random string before any real deployment.
JWT_SECRET_KEY=welfarebridge-super-secret-signing-key-change-this-in-production

# Frontend origin allowed to call this API (CORS). If you open the frontend HTML files directly
# from disk, the browser sends Origin: null - this is already allowed by default in config.py.
FRONTEND_ORIGIN=http://localhost:5500
